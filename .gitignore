# ─────────────────────────────────────────────────────────────
#  Данные пользователя — никогда не попадают в репозиторий
# ─────────────────────────────────────────────────────────────
#  Хранилище с реальными API-ключами и личными секретами
vault.json
vault.enc
vault.salt

#  Тексты личных заметок (открываются в Блокноте)
notes/

#  Автобекапы хранилища (vault_*.json) и ручные копии кода (app_working_*.py)
backup/

# ─────────────────────────────────────────────────────────────
#  Зависимости — ставятся локально через pip --target в libs\
# ─────────────────────────────────────────────────────────────
libs/

# ─────────────────────────────────────────────────────────────
#  Логи, кэш, временные файлы
# ─────────────────────────────────────────────────────────────
*.log
*.tmp
__pycache__/
*.py[cod]
*.pyo
_audit_tmp/
.tmp/

# ─────────────────────────────────────────────────────────────
#  OS
# ─────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
ehthumbs.db
